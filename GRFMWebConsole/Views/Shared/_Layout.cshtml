<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title | GRFM</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="@Url.Content("~/Content/pluggins/fontawesome/all.min.css")" />

    <!-- Theme style -->
    <link rel="stylesheet" href="@Url.Content("~/Content/dist/adminlte.min.css")">

    <!-- Custom -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/custom.css")" />

    <!-- Toastr -->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/toastr/toastr.min.css")" />

    <!-- jQuery -->
    <script src="@Url.Content("~/Scripts/plugins/jquery/jquery.min.js")"></script>

    <!-- Bootstrap 4 -->
    <script src="@Url.Content("~/Scripts/plugins/bootstrap/bootstrap.bundle.min.js")"></script>

    <!-- Toastr -->
    <script src="@Url.Content("~/Scripts/plugins/toastr/toastr.min.js")"></script>

    <!-- AdminLTE App -->
    <script src="@Url.Content("~/Scripts/dist/js/adminlte.min.js")"></script>

    <!-- Unobtrusive -->
    <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.min.js")"></script>

    <!-- Masking -->
    <script src="@Url.Content("~/Scripts/jquery.mask.min.js")"></script>

    <!-- Custom Notification -->
    <script src="@Url.Content("~/custom-js/layout/custom-notification.js")"></script>

    <!-- Custom Functions -->
    <script src="@Url.Content("~/custom-js/layout/custom-functions.js")"></script>

</head>
<body class="hold-transition sidebar-mini">
    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>
            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="@Url.Action("Index", "Dashboard")" class="brand-link">
                <img src="@Url.Content("~/Content/assets/img/AdminLTELogo.png")" alt="GRFM" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">GRFM</span>
            </a>
            <!-- Sidebar -->
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Dashboard")" class="nav-link @(ViewBag.Title == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p> Dashboard </p>
                            </a>
                        </li>

                        @{
                            bool isMasterActive = ViewBag.Title == "User" ||  ViewBag.Title == "Client" ||  ViewBag.Title == "UnitOfMeasure";
                        }

                        <li class="nav-item @(isMasterActive ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isMasterActive ? "active" : "")">
                                <i class="nav-icon fas fa-file-alt"></i>
                                <p>
                                    Master
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>

                            <ul class="nav nav-treeview" style="display: @(isMasterActive ? "block" : "none")">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "User")" class="nav-link @(ViewBag.Title == "User" ? "active" : "")">
                                        <i class="nav-icon fas fa-user-circle"></i>
                                        <p> User </p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Client")" class="nav-link @(ViewBag.Title == "Client" ? "active" : "")">
                                        <i class="nav-icon fas fa-handshake"></i>
                                        <p> Client </p>
                                    </a>
                                </li>


                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "UnitOfMeasure")" class="nav-link @(ViewBag.Title == "UnitOfMeasure" ? "active" : "")">
                                        <i class="nav-icon fas fa-balance-scale"></i>
                                        <p> Unit Of Measure </p>
                                    </a>
                                </li>
                            </ul>
                        </li>


                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Property")" class="nav-link @(ViewBag.Title == "Property" ? "active" : "")">
                                <i class="nav-icon fas fa-house-user"></i>
                                <p> Property </p>
                            </a>
                        </li>
                        <li class="nav-item">
                                <a href="@Url.Action("Index", "Quotation")" class="nav-link @(ViewBag.Title == "Quotation" ? "active" : "")">
                                    <i class="nav-icon fas fa-rupee-sign"></i>
                                    <p> Quotation </p>
                                </a>
                            </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "ChangePassword")" class="nav-link @(ViewBag.Title == "ChangePassword" ? "active" : "")">
                                <i class="nav-icon fas fa-unlock-alt"></i>
                                <p> Change Password </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Logout")" class="nav-link">
                                <i class="nav-icon fas fa-sign-out-alt"></i>
                                <p> Logout </p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>

        @RenderBody()

        <div id="loading-element" class="custom-loader">
            <div class="loader">
                <img src="@Url.Content("~/Content/assets/img/Admin/Loading.gif")" style="height:100px;" />
            </div>
            <br />
        </div>

        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 1.0.0
            </div>
            <strong>Copyright &copy; 2025-2026 <a href="javascript:void(0)">GRFM</a>.</strong> All rights reserved.
        </footer>

        <!-- Control Sidebar -->
        <aside class="control-sidebar control-sidebar-dark">
            <!-- Control sidebar content goes here -->
        </aside>
        <!-- /.control-sidebar -->
    </div>
    <!-- ./wrapper -->


</body>
</html>
