@model GRFMWebConsole.Domain.Property

<div class="modal fade" id="modal-property" tabindex="-1" aria-labelledby="PropertyModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="PropertyModalLabel">Edit Property</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="PropertyModalLabel">Add Property</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                <div class="row mb-3">
                    <div class="col">
                        <label>Client <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.ClientId, ViewBag.Clients as List<SelectListItem>, "Select Client", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <label>Property Number <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.PropertyNumber, new { @class = "form-control", placeholder = "Enter Property Name" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Society Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.SocietyName, new { @class = "form-control", placeholder = "Enter Society Name" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>LandMark <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.LandMark, new { @class = "form-control", placeholder = "Enter LandMark" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Area <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Area, new { @class = "form-control", placeholder = "Enter Area" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>City <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.City, new { @class = "form-control", placeholder = "Enter City" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>State <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.State, new { @class = "form-control", placeholder = "Enter State" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-6">
                        <label>Zip Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.ZipCode, new { @class = "form-control", placeholder = "Enter Zip Code" })
                        <span class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/property/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)



